# =============================================================================
# .env.example — copie para .env e ajuste.   cp .env.example .env
# O .env é lido pelo Makefile (make init/plan/apply) e NUNCA deve ser commitado.
# Nada aqui é segredo de aplicação: senhas do AD/MySQL são geradas pelo
# Terraform e guardadas no SSM Parameter Store.
# =============================================================================

# ---------- Credenciais AWS ----------
# Recomendado: perfil SSO/IAM Identity Center (aws configure sso)
AWS_PROFILE=faf-lab
AWS_REGION=us-east-1
# Alternativa (evite chaves longas; prefira SSO ou OIDC no CI):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------- Backend remoto (saída de `make bootstrap`) ----------
# Cada stack grava em <TF_STATE_PREFIX>/<stack>.tfstate
#   faf-lab/01-network-stack.tfstate | 02-security-stack.tfstate | 03-compute-stack.tfstate
TF_STATE_BUCKET=faf-tfstate-123456789012-us-east-1
TF_STATE_PREFIX=faf-lab

# ---------- Variáveis compartilhadas pelas stacks (TF_VAR_<nome>) ----------
# Valores específicos de cada stack ficam em <stack>/terraform.tfvars.
# Atenção: terraform.tfvars tem precedência sobre TF_VAR_* — não repita estas chaves lá.
TF_VAR_project=faf
TF_VAR_environment=lab
TF_VAR_region=us-east-1
TF_VAR_owner=seu-nome
TF_VAR_cost_center=portfolio
TF_VAR_repository=https://github.com/seu-usuario/terraform-aws-faf-lab

# [02-security-stack] Quem pode acessar o FAF_FIREWALL. Descubra seu IP: curl -s https://checkip.amazonaws.com
# Formato HCL/JSON de lista. NÃO use 0.0.0.0/0 sem necessidade.
TF_VAR_allowed_ingress_cidrs=["203.0.113.10/32"]
